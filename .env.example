# Copia este archivo a `.env` y rellena los valores de tu proyecto de Firebase.
# `.env` NO se sube a git (está en .gitignore); este archivo sí, sin valores reales.
#
# Uso en las apps:
#   flutter run --dart-define-from-file=.env
#
# Dónde sacar cada valor: consola de Firebase → Configuración del proyecto →
# Tus apps (Android / iOS). Los archivos google-services.json y
# GoogleService-Info.plist también están ahí y tampoco se suben.

# --- Proyecto ---
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Región de las Cloud Functions (por defecto us-central1)
FIREBASE_REGION=us-central1

# --- Android ---
FIREBASE_API_KEY_ANDROID=
FIREBASE_APP_ID_ANDROID_HOST=
FIREBASE_APP_ID_ANDROID_PLAY=

# --- iOS ---
FIREBASE_API_KEY_IOS=
FIREBASE_APP_ID_IOS_HOST=
FIREBASE_APP_ID_IOS_PLAY=

# --- Inicio de sesión con Google (solo Host) ---
# "ID de cliente web" del proveedor Google en Authentication
GOOGLE_SERVER_CLIENT_ID=

# --- Desarrollo local con el emulador de Firebase ---
USE_FIREBASE_EMULATOR=false
# Desde el emulador de Android, tu Mac es 10.0.2.2
FIREBASE_EMULATOR_HOST=10.0.2.2
