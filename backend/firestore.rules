rules_version = '2';

// Los clientes solo leen. Reservas, sorteo y cambios de estado pasan por las
// Cloud Functions (`functions/src/index.ts`), que validan todo en el servidor.
service cloud.firestore {
  match /databases/{database}/documents {
    match /salas/{codigo} {
      // Entrar con el código o el enlace: quien tenga sesión (aunque sea anónima)
      // puede leer esa sala.
      allow get: if request.auth != null;

      // Listar: solo las salas públicas y las propias. Las privadas no se pueden
      // enumerar; las consultas deben filtrar por `publica == true` o por el
      // `organizadorUid` de quien pregunta.
      allow list: if request.auth != null
        && (resource.data.publica == true
            || resource.data.organizadorUid == request.auth.uid);

      allow write: if false;

      match /filas/{fila} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // La billetera es de cada cuenta: solo su dueña la lee, y solo el servidor la
    // modifica (reservas, recargas, devoluciones y premios).
    match /billeteras/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /movimientos/{movimiento} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
